# ZKode Production Environment Variables
# Copy this file to .env.production and update values for production deployment

# Cloudflare Account
CLOUDFLARE_ACCOUNT_ID=your-account-id-here

# Database IDs (get these from Cloudflare Dashboard)
CLOUDFLARE_D1_DEV_ID=your-dev-database-id
CLOUDFLARE_D1_STAGING_ID=your-staging-database-id
CLOUDFLARE_D1_PROD_ID=your-production-database-id

# R2 Bucket Names
R2_TEMPLATES_DEV=zkode-templates-dev
R2_TEMPLATES_STAGING=zkode-templates-staging
R2_TEMPLATES_PROD=zkode-templates-prod
R2_PROJECTS_DEV=zkode-projects-dev
R2_PROJECTS_STAGING=zkode-projects-staging
R2_PROJECTS_PROD=zkode-projects-prod

# Application Secrets (generate with: openssl rand -base64 32)
JWT_SECRET=your-jwt-secret-key-here
API_SECRET=your-api-secret-key-here

# External URLs
FRONTEND_URL_DEV=http://localhost:5173
FRONTEND_URL_STAGING=https://staging.zkode.app
FRONTEND_URL_PROD=https://zkode.app

API_BASE_URL_DEV=http://localhost:8787
API_BASE_URL_STAGING=https://staging-api.zkode.app
API_BASE_URL_PROD=https://api.zkode.app

# Domain Configuration
PRODUCTION_DOMAIN=zkode.app
STAGING_DOMAIN=staging.zkode.app

# AI Configuration
AI_MODEL_FAST=@cf/meta/llama-3.1-8b-instruct
AI_MODEL_BALANCED=@cf/meta/llama-3.1-8b-instruct
AI_MODEL_CREATIVE=@cf/meta/llama-3.1-8b-instruct
AI_MODEL_CODE=@cf/meta/llama-3.1-8b-instruct

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_REQUESTS_PER_HOUR=1000
RATE_LIMIT_REQUESTS_PER_DAY=10000

# Analytics (optional)
ANALYTICS_API_KEY=your-analytics-api-key
ERROR_TRACKING_DSN=your-sentry-dsn

# GitHub Integration (for CI/CD)
GITHUB_TOKEN=your-github-token

# Notification webhooks (optional)
SLACK_WEBHOOK_URL=your-slack-webhook-url
DISCORD_WEBHOOK_URL=your-discord-webhook-url